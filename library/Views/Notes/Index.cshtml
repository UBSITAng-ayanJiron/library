@using Library.Models
@model List<Note>
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Notes</h1>
        <p class="text-muted mb-0">@Model.Count notes on the notepad</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">+ Add a note</a>
    </div>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Title</th>
            <th>Body</th>
            <th>Created</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var note in Model)
        {
            <tr>
                <td class="text-end">@note.NoteId</td>
                <td>@note.Title</td>
                <td>@(note.Body ?? "—")</td>
                <td>@(note.CreatedOn?.ToString("yyyy-MM-dd") ?? "—")</td>
                <td>
                    <div class="action-buttons">
                        <a asp-action="Edit" asp-route-id="@note.NoteId" class="btn btn-edit">Edit</a>      <!-- cut off in PDF -->
                        <a asp-action="Delete" asp-route-id="@note.NoteId" class="btn btn-delete">Delete</a> <!-- cut off in PDF -->
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>